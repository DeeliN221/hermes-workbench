# Copy to .env (ignored by Git). Empty values must be filled before starting.
WORKBENCH_IMAGE=
WORKBENCH_UID=
WORKBENCH_GID=
WORKBENCH_DATA_DIR=
WORKBENCH_WORKSPACE_DIR=
WORKBENCH_ALLOWED_USERS=
# Set this only when the mounted Codex database was created under a service
# account that differs from the authenticated dashboard user.
WORKBENCH_DATA_USER=
WORKBENCH_PROXY_SECRET=
WORKBENCH_NETWORK=
# Change only if you intentionally trust releases from a fork.
WORKBENCH_RELEASE_REPOSITORY=DeeliN221/hermes-workbench

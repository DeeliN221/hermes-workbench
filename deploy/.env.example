# Copy to .env (ignored by Git). Empty values must be filled before starting.
WORKBENCH_IMAGE=
WORKBENCH_UID=
WORKBENCH_GID=
WORKBENCH_DATA_DIR=
WORKBENCH_WORKSPACE_DIR=
WORKBENCH_ALLOWED_USERS=
WORKBENCH_PROXY_SECRET=
# Optional distinct machine credential for private status polling; empty disables it.
# Internal callers send X-Workbench-Status-Token. Never expose this to browsers.
HERMES_WORKBENCH_INTERNAL_STATUS_TOKEN=
WORKBENCH_NETWORK=
# Change only if you intentionally trust releases from a fork.
WORKBENCH_RELEASE_REPOSITORY=DeeliN221/hermes-workbench

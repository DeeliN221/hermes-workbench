# Separate state and explicit workspace; paths are illustrative.
WORKBENCH_AUTH_MODE=local
WORKBENCH_STANDALONE_HOME=/var/lib/workbench-standalone
WORKBENCH_WORKSPACE_ROOT=/srv/workbench/workspace
WORKBENCH_RUNTIME_URL=http://127.0.0.1:PORT
WORKBENCH_RUNTIME_BRIDGE_TOKEN_FILE=/run/secrets/workbench-bridge-token
# The matching DSH bridge uses WORKBENCH_DSH_BRIDGE_TOKEN_FILE pointing to the same 0600 file.
# Build: pnpm build:standalone
# Start: pnpm start:standalone --port PORT
# Open the local bootstrap URL printed by the host. This credential is reusable until rotated.

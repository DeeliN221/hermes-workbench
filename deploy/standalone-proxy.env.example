# Explicit opt-in. The backend still binds loopback; configure your proxy separately.
WORKBENCH_AUTH_MODE=trusted-proxy
WORKBENCH_PUBLIC_ORIGIN=https://workbench.example.test
WORKBENCH_ALLOWED_HOSTS=workbench.example.test
WORKBENCH_ALLOWED_USERS=operator-a,operator-b
WORKBENCH_TRUSTED_PROXY_SECRET_FILE=/run/secrets/workbench-proxy-secret
WORKBENCH_STANDALONE_HOME=/var/lib/workbench-standalone
# Each authenticated user receives a private hashed child directory.
WORKBENCH_WORKSPACE_ROOT=/srv/workbench/users
WORKBENCH_RUNTIME_URL=http://127.0.0.1:PORT
WORKBENCH_RUNTIME_BRIDGE_TOKEN_FILE=/run/secrets/workbench-bridge-token
# Secret files must be regular owner-only files (0600); do not expose them in the browser.
# Existing proxy header names: x-hermes-proxy-secret and remote-user.
# Compatibility env names: HERMES_DASHBOARD_TRUSTED_PROXY_SECRET and HERMES_WORKBENCH_ALLOWED_USERS.
# The proxy must REPLACE identity/secret headers, preserve the configured public Host,
# and forward browser Origin unchanged for HTTP and WebSocket requests.
# X-Forwarded-Host/Proto/User are never identity or origin authorities.
# Build: pnpm build:standalone
# Start: pnpm start:standalone --port PORT
# No local bootstrap cookie bypass is accepted in this mode.

# Optional background task service, credentials remain backend-only.
# WORKBENCH_FLEET_URL=http://127.0.0.1:PORT
# WORKBENCH_FLEET_TOKEN_FILE=/run/secrets/workbench-fleet-token
# WORKBENCH_FLEET_REVIEW_TOKEN_FILE=/run/secrets/workbench-fleet-review-token
# WORKBENCH_FLEET_MACHINE=isolated-worker
# WORKBENCH_FLEET_CAPABILITY=shell

{
  "name": "hermes-workbench",
  "version": "20261022-3",
  "private": false,
  "description": "Minecraft-inspired workspace for Hermes Agent Dashboard",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts && vite build --config vite.loader.config.ts && python3 scripts/build-provenance.py",
    "typecheck": "python3 scripts/check-typescript-source.py && tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:python": "env -u CODEX_APP_SERVER_ENDPOINT -u CODEX_HOME uv run --no-project --with-requirements requirements-dev.txt pytest -q tests",
    "release:verify": "bash scripts/verify-release.sh",
    "version:check": "python3 scripts/version.py --check",
    "version:set": "python3 scripts/version.py",
    "release:package": "python3 scripts/package-release.py",
    "privacy:check": "python3 scripts/check-public-content.py",
    "pr:check": "python3 scripts/check-pr-body.py",
    "history:check": "python3 scripts/check-history.py",
    "deploy:dev": "python3 scripts/deploy-dev.py",
    "prebuild": "python3 scripts/check-dev-source.py",
    "release:smoke": "python3 scripts/smoke-test-release.py"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-liquid": "^6.3.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "mermaid": "^12.1.0",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "happy-dom": "^21.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DeeliN221/hermes-workbench.git"
  },
  "homepage": "https://github.com/DeeliN221/hermes-workbench",
  "bugs": {
    "url": "https://github.com/DeeliN221/hermes-workbench/issues"
  }
}

{
  "node": "/opt/node/bin/node",
  "python": "/srv/workbench/python/bin/python",
  "state_dir": "/var/lib/workbench/supervisor",
  "app_home": "/var/lib/workbench/app",
  "workspace": "/srv/workbench/workspaces",
  "dsh_home": "/var/lib/workbench/dsh-home",
  "bridge_token_file": "/var/lib/workbench/secrets/bridge.token",
  "module_root": "/srv/workbench/runtime-installs/COMMIT",
  "provider": "configured-provider",
  "model": "configured-model",
  "app_port": 38880,
  "bridge_port": 38881,
  "host_port": 38882,
  "max_restarts": 2,
  "startup_timeout": 30,
  "stop_timeout": 5,
  "health_interval": 2,
  "environment": {
    "WORKBENCH_AUTH_MODE": "local"
  }
}

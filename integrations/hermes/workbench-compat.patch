index 0000000000..4725fbfa2f
--- /dev/null
+++ b/tests/agent/transports/test_mcp_kanban_handoff.py
@@ -0,0 +1,93 @@
+"""Real MCP dispatch must preserve file handoffs in native card attachments."""
+import asyncio
+import base64
+import json
+import os
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc, kanban_db_workspace as kbw
+from agent.transports.hermes_tools_mcp_server import _build_server
+
+
+@pytest.fixture
+def handoff(tmp_path, monkeypatch):
+    for key in tuple(os.environ):
+        if key.startswith('HERMES_KANBAN_') or key == 'HERMES_DELEGATED_CHILD_CONTEXT':
+            monkeypatch.delenv(key)
+    home = tmp_path / '.hermes'
+    home.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    kb.init_db()
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title='Export spreadsheet', assignee='test-worker')
+        ws = kbw.resolve_workspace(kb.get_task(conn, tid))
+        kbw.set_workspace_path(conn, tid, ws)
+        kb.claim_task(conn, tid)
+        run_id = kb.get_task(conn, tid).current_run_id
+    monkeypatch.setenv('HERMES_KANBAN_TASK', tid)
+    monkeypatch.setenv('HERMES_KANBAN_RUN_ID', str(run_id))
+    from tools.registry import invalidate_check_fn_cache
+    invalidate_check_fn_cache()
+    import model_tools
+    original_definitions = model_tools.get_tool_definitions
+    monkeypatch.setattr(model_tools, "get_tool_definitions",
+                        lambda **kw: original_definitions(enabled_toolsets=["kanban"], **kw))
+    server = _build_server()
+    def call(name, **args):
+        result = asyncio.run(server.call_tool(name, args))
+        return json.loads(result.content[0].text)
+    return tid, ws, call, server
+
+
+@pytest.mark.parametrize('tool', ['kanban_complete', 'kanban_request_review'])
+@pytest.mark.parametrize('mode', ['scratch', 'attached', 'no_files'])
+def test_mcp_handoff_uses_native_attachments(handoff, tool, mode):
+    tid, ws, call, server = handoff
+    payload = b'file handoff integrity fixture'
+    paths = []
+    if mode == 'scratch':
+        file = ws / 'report.xlsx'
+        file.write_bytes(payload)
+        paths = [str(file)]
+    elif mode == 'attached':
+        assert call('kanban_attach', filename='report.xlsx', content_base64=base64.b64encode(payload).decode())['ok']
+        call('kanban_attachments')
+        with kbc.connect() as conn:
+            paths = [kb.list_attachments(conn, tid)[0].stored_path]
+    result = call(tool, summary='Verified export', artifacts=paths)
+    assert result.get('ok'), result
+    with kbc.connect() as conn:
+        assert kb.get_task(conn, tid).status == ('done' if tool == 'kanban_complete' else 'review')
+        attachments = kb.list_attachments(conn, tid)
+        if mode == 'no_files':
+            assert attachments == []
+        else:
+            assert len(attachments) == 1
+            assert Path(attachments[0].stored_path).read_bytes() == payload
+            assert kb.latest_run(conn, tid).metadata['artifacts'] == [attachments[0].stored_path]
+
+
+@pytest.mark.parametrize('tool', ['kanban_complete', 'kanban_request_review'])
+def test_bad_handoff_keeps_task_running(handoff, tool, tmp_path, monkeypatch):
+    tid, ws, call, server = handoff
+    file = tmp_path / 'report.xlsx'
+    file.write_bytes(b'outside task workspace')
+    for args in [
+        {'metadata': {'workbook': str(file)}},
+        {'artifacts': [str(file)]},
+        {'artifacts': [], 'metadata': {'artifacts': [str(file)]}},
+        {'artifacts': [str(ws / 'missing.xlsx')]},
+    ]:
+        result = call(tool, summary='Exported', **args)
+        assert 'error' in result, result
+        with kbc.connect() as conn:
+            assert kb.get_task(conn, tid).status == 'running'
+            assert kb.list_attachments(conn, tid) == []
+    monkeypatch.setenv('HERMES_DELEGATED_CHILD_CONTEXT', '1')
+    result = call(tool, summary='No files', artifacts=[])
+    assert 'error' in result
+    with kbc.connect() as conn:
+        assert kb.get_task(conn, tid).status == 'running'

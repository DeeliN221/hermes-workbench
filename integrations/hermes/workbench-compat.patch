+from types import SimpleNamespace
+from unittest.mock import Mock
+import threading
+import pytest
+from agent.codex_runtime import make_codex_app_server_event_bridge
+from agent.transports.codex_app_server_session import CodexAppServerSession, TurnResult
+
+
+def test_work_events_refresh_activity_but_keepalives_do_not():
+    agent = SimpleNamespace(_touch_activity=Mock())
+    bridge = make_codex_app_server_event_bridge(agent)
+    bridge({'method': 'thread/tokenUsage/updated', 'params': {}})
+    agent._touch_activity.assert_not_called()
+    bridge({'method': 'item/agentMessage/delta', 'params': {'delta': 'research'}})
+    bridge({'method': 'item/completed', 'params': {'item': {'type': 'commandExecution', 'id': 'a', 'command': 'true'}}})
+    assert agent._touch_activity.call_count == 2
+
+
+@pytest.mark.parametrize('deadline, expected_interrupted', [(None, False), (600.0, True)])
+def test_cron_can_outlive_absolute_deadline_but_explicit_deadline_still_works(monkeypatch, deadline, expected_interrupted):
+    import agent.transports.codex_app_server_session as mod
+    clock = [0.0]
+    monkeypatch.setattr(mod.time, 'monotonic', lambda: clock[0])
+    session = CodexAppServerSession.__new__(CodexAppServerSession)
+    session._interrupt_event = threading.Event()
+    session._thread_id = 'thread'
+    session._subprocess_died = lambda result: False
+    session._issue_interrupt = Mock()
+    session._format_error_with_stderr = lambda text: text
+    notes = iter(['item/started', 'item/completed', 'turn/completed'])
+    def take_notification(timeout):
+        clock[0] += 400
+        return {'method': next(notes), 'params': {'threadId': 'thread', 'turnId': 'turn'}}
+    session._client = SimpleNamespace(take_server_request=lambda timeout: None, take_notification=take_notification)
+    result = TurnResult(turn_id='turn', thread_id='thread')
+    session._drive_turn(result, turn_timeout=deadline, notification_poll_timeout=0,
+                       timeout_label='turn', on_server_request=lambda req: False,
+                       on_note=lambda note, method: method == 'turn/completed')
+    assert result.interrupted is expected_interrupted
+    assert session._issue_interrupt.called is expected_interrupted

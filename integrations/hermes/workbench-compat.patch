index 0000000000..a1ee2b7275
--- /dev/null
+++ b/tests/agent/transports/test_codex_startup_retry.py
@@ -0,0 +1,36 @@
+from unittest.mock import patch
+import pytest
+from agent.transports.codex_app_server_session import CodexAppServerSession
+from agent.transports.codex_app_server import CodexAppServerError
+
+class Client:
+    def __init__(self, error=None): self.error=error; self.closed=False; self.calls=[]
+    def initialize(self, **kw):
+        self.calls.append(('initialize',kw))
+        if self.error: raise self.error
+    def close(self): self.closed=True
+    def request(self, method, params, timeout):
+        self.calls.append((method,params));return {'thread':{'id':'one'}}
+
+def test_timeout_restarts_before_any_turn_and_closes_first_client():
+    first,second=Client(TimeoutError('cold')),Client()
+    with patch('agent.transports.codex_app_server_session._get_hermes_version',return_value='test'):
+        session=CodexAppServerSession(client_factory=lambda **kw: first if not first.closed else second)
+        assert session.ensure_started()=='one'
+        assert first.closed
+        assert [x[0] for x in first.calls]==['initialize']
+        assert [x[0] for x in second.calls]==['initialize','thread/start']
+        assert second.calls[0][1]['timeout']>10
+        assert session.ensure_started()=='one'
+        assert len(second.calls)==2
+
+def test_retry_budget_and_protocol_errors():
+    clients=[]
+    def factory(**kw):
+        c=Client(TimeoutError('still cold'));clients.append(c);return c
+    with patch('agent.transports.codex_app_server_session._get_hermes_version',return_value='test'):
+        with pytest.raises(TimeoutError):CodexAppServerSession(client_factory=factory).ensure_started()
+        assert len(clients)==2
+        bad=Client(CodexAppServerError(-1,'bad config'))
+        with pytest.raises(CodexAppServerError):CodexAppServerSession(client_factory=lambda **kw:bad).ensure_started()
+        assert len(bad.calls)==1

--- /dev/null
+++ b/hermes_cli/plugin_paths.py
@@ -0,0 +1,17 @@
+"""Resolve installed plugin and persistent data directories for either home layout."""
+from pathlib import Path
+
+
+def plugin_install_root(home: Path) -> Path:
+    """Use the grouped layout when its installation directory exists."""
+    home = Path(home)
+    nested = home / "plugins" / "dist"
+    return nested if nested.is_dir() else home / "plugins"
+
+
+def plugin_data_root(home: Path) -> Path:
+    """Keep data beside installations in grouped homes, preserving other profiles."""
+    home = Path(home)
+    if (home / "plugins" / "dist").is_dir():
+        return home / "plugins" / "data"
+    return home / "plugin-data"

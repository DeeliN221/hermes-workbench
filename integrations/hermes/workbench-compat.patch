+"""Board-level routing defaults shared by task creation and dispatch."""
+
+from typing import Optional
+
+
+def validate_board_profile(name: Optional[str]) -> Optional[str]:
+    from hermes_cli.profiles import profile_exists
+
+    name = (name or "").strip() or None
+    if name and not profile_exists(name):
+        raise ValueError(f"Board default profile {name!r} does not exist")
+    return name
+
+
+def board_default_assignee(board: Optional[str], *, validate: bool = True) -> Optional[str]:
+    from hermes_cli import kanban_db as kb
+
+    meta = kb.read_board_metadata(board if board is not None else kb.get_current_board())
+    name = (meta.get("default_assignee") or "").strip() or None
+    # Keep broken bindings for dispatch's nonspawnable diagnostics; never use
+    # the global/default agent as a silent replacement.
+    return validate_board_profile(name) if validate else name

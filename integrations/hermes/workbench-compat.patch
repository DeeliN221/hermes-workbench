+"""Real REST/SQLite routing across boards, including unavailable profiles."""
+
+import importlib.util
+import sys
+from pathlib import Path
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_dispatch as kbd
+
+
+@pytest.fixture
+def client(tmp_path, monkeypatch):
+    home = tmp_path / '.hermes'
+    home.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    monkeypatch.setenv('HERMES_KANBAN_HOME', str(home))
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    for name in ('health-advisor', 'finance-advisor'):
+        (home / 'profiles' / name).mkdir(parents=True)
+    path = Path(__file__).resolve().parents[2] / 'plugins/kanban/dashboard/plugin_api.py'
+    spec = importlib.util.spec_from_file_location('kanban_board_profiles_api', path)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = mod
+    spec.loader.exec_module(mod)
+    app = FastAPI()
+    app.include_router(mod.router)
+    with TestClient(app) as client:
+        yield client
+
+
+def test_board_routing_inherits_and_explicit_assignment_wins(client):
+    for slug, profile in [('health', 'health-advisor'), ('money', 'finance-advisor')]:
+        response = client.post('/boards', json={'slug': slug, 'default_assignee': profile})
+        assert response.status_code == 200, response.text
+        assert response.json()['board']['default_assignee'] == profile
+        created = client.post(f'/tasks?board={slug}', json={'title': 'inherited', 'triage': True})
+        assert created.status_code == 200, created.text
+        task = created.json()['task']
+        assert (task['assignee'], task['status']) == (profile, 'triage')
+        detail = client.get(f"/tasks/{task['id']}?board={slug}").json()
+        assert detail['board_default_assignee'] == profile
+        explicit = client.post(f'/tasks?board={slug}', json={'title': 'override', 'assignee': 'default', 'triage': True})
+        assert explicit.json()['task']['assignee'] == 'default'
+    assert client.patch('/boards/health', json={'name': 'Health'}).json()['board']['default_assignee'] == 'health-advisor'
+
+
+def test_dispatch_uses_board_default_and_never_substitutes_missing_profile(client):
+    kb.create_board('health')
+    with kbc.connect_closing(board='health') as conn:
+        tid = kb.create_task(conn, title='existing unassigned', board='health')
+        kb.write_board_metadata('health', default_assignee='health-advisor')
+        result = kbd.dispatch_once(conn, board='health', dry_run=True, default_assignee='finance-advisor')
+        assert any(t == tid and who == 'health-advisor' for t, who, _ in result.spawned)
+        # A profile removed after configuration must block routing, not use the global default.
+        from hermes_cli.profiles import get_profile_dir
+        get_profile_dir('health-advisor').rmdir()
+        result = kbd.dispatch_once(conn, board='health', dry_run=True, default_assignee='finance-advisor')
+        assert not result.spawned
+        assert result.skipped_nonspawnable
+    response = client.post('/tasks?board=health', json={'title': 'missing', 'triage': True})
+    assert response.status_code == 400
+    assert client.patch('/boards/health', json={'default_assignee': 'missing'}).status_code == 400
+    assert kb.read_board_metadata('health')['default_assignee'] == 'health-advisor'

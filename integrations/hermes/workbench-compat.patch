+                raise ValueError("Each artifact must be an absolute file path.")
+            path = Path(raw.strip()).expanduser()
+            if not path.is_absolute() or not path.is_file():
+                raise ValueError(f"Artifact is not an existing absolute file: {raw}")
+            resolved = path.resolve()
+            if resolved in attached or (managed and resolved.is_relative_to(workspace.resolve())):

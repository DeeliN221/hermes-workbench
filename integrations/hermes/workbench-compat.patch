new file mode 100644
index 0000000000..fb501fca28
--- /dev/null
+++ b/hermes_cli/shared_codex.py
@@ -0,0 +1,60 @@
+"""Opt-in shared Codex authority. Non-Codex credentials remain profile-local.
+
+Codex owns refresh for this app-server deployment; Hermes reads the same file
+instead of cloning a rotating OAuth grant into its own credential pool.
+"""
+from __future__ import annotations
+import json
+import os
+from pathlib import Path
+import tempfile
+import time
+
+
+def path():
+    value = os.environ.get('HERMES_CODEX_AUTH_FILE', '').strip()
+    return Path(value).expanduser().resolve() if value else None
+
+
+def read():
+    target = path()
+    if target is None:
+        return None
+    # Codex 0.157.1 truncates then writes in place; tolerate that short window.
+    for attempt in range(6):
+        try:
+            value = json.loads(target.read_text())
+            tokens = value.get('tokens', {})
+            if not all(isinstance(tokens.get(k), str) and tokens[k].strip()
+                       for k in ('access_token', 'refresh_token')):
+                raise ValueError('Shared Codex auth has no complete OAuth grant')
+            return {'tokens': tokens, 'last_refresh': value.get('last_refresh')}
+        except (OSError, ValueError):
+            if attempt == 5:
+                raise RuntimeError('Shared Codex authentication is unavailable; restore the shared account login') from None
+            time.sleep(0.05)
+
+
+def save(tokens, last_refresh=None):
+    target = path()
+    if target is None:
+        raise RuntimeError('Shared Codex auth is not configured')
+    # Re-authentication goes to the canonical target, never replaces a local link.
+    old = json.loads(target.read_text()) if target.exists() else {}
+    merged = dict(old.get('tokens') or {})
+    merged.update(tokens)
+    old.update(auth_mode='chatgpt', tokens=merged)
+    if last_refresh:
+        old['last_refresh'] = last_refresh
+    owner = target.stat() if target.exists() else None
+    fd, name = tempfile.mkstemp(prefix='.auth-', dir=target.parent)
+    try:
+        with os.fdopen(fd, 'w') as f:
+            json.dump(old, f, indent=2)
+            f.flush(); os.fsync(f.fileno())
+        os.chmod(name, 0o660)
+        if owner and os.geteuid() == 0:
+            os.chown(name, owner.st_uid, owner.st_gid)
+        os.replace(name, target)
+    finally:
+        if os.path.exists(name): os.unlink(name)
